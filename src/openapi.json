{
  "openapi": "3.1.0",
  "info": {
    "title": "apis-to-mcp REST API",
    "version": "1.0.0",
    "description": "REST API served by apis-to-mcp, which proxies each request to the upstream API (JSONPlaceholder by default). Each operationId matches the name of the MCP tool exposed for that operation."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local dev server (npm run dev)"
    },
    {
      "url": "https://jsonplaceholder.typicode.com",
      "description": "Upstream API"
    }
  ],
  "security": [],
  "tags": [
    {
      "name": "Posts",
      "description": "Operations on posts."
    },
    {
      "name": "Comments",
      "description": "Operations on comments."
    },
    {
      "name": "Albums",
      "description": "Operations on albums."
    },
    {
      "name": "Photos",
      "description": "Operations on photos."
    },
    {
      "name": "Users",
      "description": "Operations on users."
    },
    {
      "name": "Todos",
      "description": "Operations on todos."
    }
  ],
  "paths": {
    "/posts": {
      "get": {
        "operationId": "list_posts",
        "tags": [
          "Posts"
        ],
        "summary": "List posts",
        "description": "List posts. Optional filters narrow results by field value.",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Only return posts whose userId matches."
          }
        ],
        "responses": {
          "200": {
            "description": "Array of posts.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Post"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "create_post",
        "tags": [
          "Posts"
        ],
        "summary": "Create a post",
        "description": "Create a post. Writes are faked: the response echoes the new post but nothing is persisted.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created post, with a new id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post"
                }
              }
            }
          }
        }
      }
    },
    "/posts/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Id"
        }
      ],
      "get": {
        "operationId": "get_post",
        "tags": [
          "Posts"
        ],
        "summary": "Get a post",
        "description": "Get one post by id.",
        "responses": {
          "200": {
            "description": "The post.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "operationId": "update_post",
        "tags": [
          "Posts"
        ],
        "summary": "Replace a post",
        "description": "Replace a post (PUT). All fields are required. Writes are faked and not persisted.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The replaced post.",
